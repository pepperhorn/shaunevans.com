# Directus se-cms connection — required to fetch shop/bookings data at build time.
# Without these the site falls back to the static stub data in src/data/*.
# Set these in Coolify (or your CI environment) under Environment Variables.

# Base URL of the Directus instance (no trailing slash)
DIRECTUS_URL=https://your-directus-instance.example.com

# Static token with read access to products and lessons collections
DIRECTUS_TOKEN=your_static_token_here
