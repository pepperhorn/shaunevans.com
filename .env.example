# ──────────────────────────────────────────────────────────────────────────────
# se-cms (Directus instance 032cee79) — build-time data fetching
# Required for the shop and bookings pages to pull live data.
# Without these the site falls back to stub data in src/data/*.
# Set in Coolify (or CI) under Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the Directus instance (no trailing slash)
DIRECTUS_URL=https://your-directus-instance.example.com

# Static token with *read* access to: products, lessons
DIRECTUS_TOKEN=your_read_token_here


# ──────────────────────────────────────────────────────────────────────────────
# Public env vars (PUBLIC_ prefix → available in the browser bundle)
# Required for the booking form to POST submissions to Directus at runtime.
# ──────────────────────────────────────────────────────────────────────────────

# Same base URL as above — exposed to the browser for form POSTs
PUBLIC_DIRECTUS_URL=https://your-directus-instance.example.com

# Write-only token with *create* access to: booking_requests only.
# Alternatively, grant the Directus Public role create access to
# booking_requests and omit this variable entirely.
# Note: this token is visible in the browser bundle — use a
# minimal-permission write-only token, not your admin token.
PUBLIC_DIRECTUS_BOOKING_TOKEN=your_write_only_token_here


# ──────────────────────────────────────────────────────────────────────────────
# Checkout / payments (server-only — never PUBLIC_*)
# DIRECTUS_TOKEN above also needs create+read perms on:
#   orders, order_items, users (read+update for OTP)
# ──────────────────────────────────────────────────────────────────────────────

# Auth sessions: handled by Astro's built-in sessions
# (@astrojs/node filesystem driver, no env var required).

# Payment provider — only "square" implemented today
PAYMENT_PROVIDER=square

# Square API credentials (from developer.squareup.com → your app)
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_LOCATION_ID=your_square_location_id

# Square webhook signature key (from Webhooks section in your Square app).
# Required for /api/webhooks/square to accept events.
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key

# Public site URL — used to build the absolute URL that Square signs
# its webhook payloads against. Must match the URL configured in Square.
PUBLIC_SITE_URL=https://shaunevans.com
