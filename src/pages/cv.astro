---
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsPageRenderer from "../components/CmsPageRenderer.astro";
import { getPage } from "@/lib/posts";

const page = await getPage("/cv");

const pageTitle = page?.seo?.title || page?.title || "CV | Shaun Evans";
const description =
  page?.seo?.meta_description ||
  "Jazz & World Saxophonist · Musical Director · Arranger, Composer, Producer · Mentor and Clinician";
const site_name = "ShaunEvans.com";
---

<BaseLayout
  title={pageTitle}
  description={description}
  site_name={site_name}
  is404Page={false}
  hideHeaderFooter={false}
>
  {
    page ? (
      <CmsPageRenderer blocks={page.blocks} />
    ) : (
      <div class="mx-auto max-w-3xl px-4 py-8">
        <p>CV is not available right now.</p>
      </div>
    )
  }
</BaseLayout>
