---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LessonCard from "../../components/bookings/LessonCard.tsx";
import BookingPanel from "@/components/bookings/BookingPanel.tsx";
import { Badge } from "../../components/ui/badge.tsx";
import { getLessons } from "@/lib/catalog";
import { DEFAULT_SETTINGS } from "@/lib/booking/slots";

const lessons = await getLessons();
// Prerendered page: read the horizon at build time; without CMS env use the default.
let horizonWeeks = DEFAULT_SETTINGS.horizonWeeks;
if (import.meta.env.DIRECTUS_URL && import.meta.env.DIRECTUS_TOKEN) {
  const { getBookingSettings } = await import("@/lib/booking/repo");
  horizonWeeks = (await getBookingSettings()).horizonWeeks;
}

const pageTitle = "Bookings & Lessons | ShaunEvans.com";
const description =
  "Book a sax, composition, or arranging lesson with Shaun Evans — single sessions, packages, and mentorship.";
---

<BaseLayout
  title={pageTitle}
  description={description}
  site_name="ShaunEvans.com"
>
  <div class="mx-auto w-full max-w-7xl px-6 py-10 max-sm:px-4">
    <header class="mb-12 max-w-3xl space-y-4">
      <Badge variant="outline" className="text-xs">Bookings</Badge>
      <h1
        class="font-overpass-mono text-4xl tracking-tight text-gray-900 dark:text-[rgb(245,245,245)] sm:text-5xl"
      >
        Lessons, mentorship, and intensives.
      </h1>
      <p class="text-base text-gray-700 dark:text-gray-300 sm:text-lg">
        Pick a time that suits you for a single session, or buy a pack and book
        each lesson with a credit. Times are shown in your own time zone.
      </p>
    </header>

    <section class="mb-16">
      <div class="mb-6 flex items-baseline justify-between">
        <h2
          class="font-overpass-mono text-xl tracking-tight text-gray-900 dark:text-[rgb(245,245,245)]"
        >
          Packages
        </h2>
        <span class="text-xs text-gray-500 dark:text-gray-400">
          {lessons.length} options
        </span>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
        {lessons.map((lesson) => <LessonCard lesson={lesson} client:load />)}
      </div>
    </section>

    <section id="booking-panel" class="booking-panel-section mx-auto max-w-4xl scroll-mt-24">
      <BookingPanel lessons={lessons} horizonWeeks={horizonWeeks} client:only="react" />
      <p class="booking-help-link mt-4 text-sm text-gray-700 dark:text-gray-300">
        Not sure which package?
        <a href="/contact" class="underline underline-offset-2">Get in touch</a>.
      </p>
    </section>

    <section class="mx-auto mt-16 max-w-2xl space-y-3 text-sm text-gray-700 dark:text-gray-300">
      <h2
        class="font-overpass-mono text-lg tracking-tight text-gray-900 dark:text-[rgb(245,245,245)]"
      >
        How it works
      </h2>
      <ol class="ml-4 list-decimal space-y-2">
        <li>Pick a time in the calendar and add it to your cart (or book with a pack credit).</li>
        <li>Check out — the time is held for you while you pay.</li>
        <li>You get a confirmation email, and the lesson link before your session.</li>
        <li>
          Need to change? Cancel or reschedule from your account up to 24 hours
          before the lesson.
        </li>
      </ol>
    </section>
  </div>
</BaseLayout>
