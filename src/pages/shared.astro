---
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsBlogPost from "../components/CmsBlogPost.astro";
import { getPostsByTag } from "@/lib/posts";

const pageTitle = "Shared";
const posts = await getPostsByTag("shared");
---

<BaseLayout title={pageTitle} is404Page={false}>
  {
    posts.map((post) => (
      <CmsBlogPost
        url={`/shared/${post.slug}/`}
        image={post.imageUrl}
        alt={post.title}
        title={post.title}
        description={post.description}
        pubDate={post.publishedAt}
      />
    ))
  }
</BaseLayout>
