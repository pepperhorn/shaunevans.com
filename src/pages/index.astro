---
import Homepage from "../components/Homepage.astro";
import { getAllPosts } from "@/lib/posts";

const { pageTitle } = Astro.props;

const allPosts = await getAllPosts();

// Folder mapping mirrors the tag-slug → URL prefix used elsewhere on the site.
const CATEGORY_FOLDERS: Record<string, string> = {
  shared: "shared",
  stories: "stories",
  "new-charts": "new_charts",
  authors: "authors",
};

function categoryFolderFor(post: (typeof allPosts)[number]): string | null {
  for (const t of post.tags) {
    if (CATEGORY_FOLDERS[t.slug]) return CATEGORY_FOLDERS[t.slug];
  }
  return null;
}

// Featured posts that have a Directus image and live in a known category folder.
const featured = allPosts.filter((p) => {
  if (!p.imageUrl) return false;
  if (!p.tags.some((t) => t.slug === "featured")) return false;
  return categoryFolderFor(p) !== null;
});

const directusTransform = (url: string, w: number, h: number) =>
  `${url}?width=${w}&height=${h}&fit=cover&format=avif&quality=65`;

const allImages = {
  large: [] as string[],
  medium: [] as string[],
  small: [] as string[],
};
const allAlts: string[] = [];
const allUrls: string[] = [];

for (const post of featured) {
  const folder = categoryFolderFor(post)!;
  const img = post.imageUrl!;
  allImages.large.push(directusTransform(img, 1920, 1080));
  allImages.medium.push(directusTransform(img, 1280, 720));
  allImages.small.push(directusTransform(img, 854, 480));
  allAlts.push(post.title);
  allUrls.push(`/${folder}/${post.slug}/`);
}

const imageSizes = {
  width: { large: 1920, medium: 1280, small: 854 },
  height: { large: 1080, medium: 720, small: 480 },
};
---

{
  allImages.large.length > 0 ? (
    <Homepage
      title={pageTitle}
      images={JSON.stringify(allImages)}
      alt={JSON.stringify(allAlts)}
      urls={JSON.stringify(allUrls)}
      width={imageSizes.width}
      height={imageSizes.height}
    />
  ) : (
    <p>No images found</p>
  )
}
