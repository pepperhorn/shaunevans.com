---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Badge } from "../../components/ui/badge.tsx";
import { getSeries, getLearning } from "@/lib/catalog";
import { assetUrl } from "@/lib/directus";

const [seriesList, learning] = await Promise.all([getSeries(), getLearning()]);
const orphanLearning = learning.filter((l) => !l.seriesId);

const accessTierBadge: Record<string, { label: string; variant: "default" | "secondary" | "outline" }> = {
  free: { label: "Free", variant: "secondary" },
  paid: { label: "Paid", variant: "default" },
  mixed: { label: "Mixed", variant: "outline" },
};

const pageTitle = "Learn | ShaunEvans.com";
const description =
  "Saxophone study, transcriptions, and series — from open-access fundamentals to deep-dive paid courses.";
---

<BaseLayout title={pageTitle} description={description} site_name="ShaunEvans.com">
  <div class="learn-page mx-auto w-full max-w-7xl px-6 py-10 max-sm:px-4">
    <header class="learn-header mb-10 space-y-4">
      <Badge variant="outline" className="text-xs">Learn</Badge>
      <h1
        class="learn-title font-overpass-mono text-4xl tracking-tight text-gray-900 dark:text-[rgb(245,245,245)] sm:text-5xl"
      >
        Study, transcribe, and play.
      </h1>
      <p class="learn-intro max-w-2xl text-base text-gray-700 dark:text-gray-300 sm:text-lg">
        Saxophone study materials grouped into series, plus standalone lessons.
        Free items unlock instantly; paid items show a preview and unlock once
        their linked product is in your library.
      </p>
    </header>

    {
      seriesList.length > 0 && (
        <section class="learn-series-section mb-16">
          <h2 class="learn-section-heading mb-6 font-overpass-mono text-2xl text-gray-900 dark:text-[rgb(245,245,245)]">
            Series
          </h2>
          <div class="learn-series-grid grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {seriesList.map((s) => {
              const tier = accessTierBadge[s.access_tier];
              return (
                <a
                  href={`/learn/series/${s.slug}/`}
                  class="series-card group block overflow-hidden rounded-xl border border-border/60 bg-card shadow transition-shadow hover:shadow-lg"
                >
                  <div class="series-card-cover aspect-video overflow-hidden bg-muted">
                    {s.coverImage ? (
                      <img
                        src={assetUrl(s.coverImage, "")}
                        alt={s.title}
                        loading="lazy"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center text-gray-400">
                        <span class="font-overpass-mono text-xs">No cover</span>
                      </div>
                    )}
                  </div>
                  <div class="series-card-body space-y-2 p-4">
                    <div class="flex items-center gap-2">
                      <Badge variant={tier.variant} className="text-xs">
                        {tier.label}
                      </Badge>
                      {s.itemCount != null && s.itemCount > 0 && (
                        <span class="text-xs text-gray-500 dark:text-gray-400">
                          {s.itemCount} item{s.itemCount === 1 ? "" : "s"}
                        </span>
                      )}
                    </div>
                    <h3 class="font-medium leading-tight">{s.title}</h3>
                    {s.description && (
                      <p class="line-clamp-2 text-sm text-muted-foreground">{s.description}</p>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    {
      orphanLearning.length > 0 && (
        <section class="learn-orphans-section mb-16">
          <h2 class="learn-section-heading mb-6 font-overpass-mono text-2xl text-gray-900 dark:text-[rgb(245,245,245)]">
            Standalone lessons
          </h2>
          <div class="learn-orphans-grid grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {orphanLearning.map((l) => (
              <a
                href={`/learn/${l.slug}/`}
                class="learn-card group block overflow-hidden rounded-xl border border-border/60 bg-card shadow transition-shadow hover:shadow-lg"
              >
                <div class="learn-card-cover aspect-video overflow-hidden bg-muted">
                  {l.coverImage ? (
                    <img
                      src={assetUrl(l.coverImage, "")}
                      alt={l.title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center text-gray-400">
                      <span class="font-overpass-mono text-xs">No cover</span>
                    </div>
                  )}
                </div>
                <div class="learn-card-body space-y-2 p-4">
                  <Badge variant={l.accessTier === "free" ? "secondary" : "default"} className="text-xs">
                    {l.accessTier === "free" ? "Free" : "Paid"}
                  </Badge>
                  <h3 class="font-medium leading-tight">{l.title}</h3>
                  {l.summary && (
                    <p class="line-clamp-2 text-sm text-muted-foreground">{l.summary}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {seriesList.length === 0 && orphanLearning.length === 0 && (
      <p class="learn-empty py-12 text-center text-gray-500 dark:text-gray-400">
        Nothing here yet — content is being prepared.
      </p>
    )}
  </div>
</BaseLayout>
