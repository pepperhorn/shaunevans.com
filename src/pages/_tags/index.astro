---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts } from "@/lib/posts";

const posts = await getAllPosts();
const tagMap = new Map<string, { name: string; slug: string }>();
for (const p of posts) {
  for (const t of p.tags) {
    if (!tagMap.has(t.slug)) tagMap.set(t.slug, t);
  }
}
const tags = [...tagMap.values()].sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Tag Index" is404Page={false}>
  <div class="tag-index mx-auto max-w-4xl px-4 py-8">
    <h1 class="font-overpass-mono text-3xl mb-6 uppercase">All Tags</h1>
    <div class="flex flex-wrap gap-3">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag.slug}/`}
            class="tag-chip bg-slate-600 text-[rgb(245,245,245)] px-3 py-1 rounded-sm font-overpass-mono uppercase no-underline hover:opacity-80"
          >
            {tag.name}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
