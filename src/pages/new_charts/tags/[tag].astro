---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CmsBlogPost from "../../../components/CmsBlogPost.astro";
import { getCategoryPostsWithTag, getCategoryTags } from "@/lib/posts";

export async function getStaticPaths() {
  const tags = await getCategoryTags("new-charts");
  return tags.map((t) => ({ params: { tag: t.slug }, props: { tag: t } }));
}

const { tag } = Astro.props as { tag: { name: string; slug: string } };
const posts = await getCategoryPostsWithTag("new-charts", tag.slug);
const URL_PREFIX = "new_charts";
---

<BaseLayout title={tag.name} is404Page={false}>
  {
    posts.map((post) => (
      <CmsBlogPost
        url={`/${URL_PREFIX}/${post.slug}/`}
        image={post.imageUrl}
        alt={post.title}
        title={post.title}
        description={post.description}
        pubDate={post.publishedAt}
      />
    ))
  }
</BaseLayout>
