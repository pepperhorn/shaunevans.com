---
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsPageRenderer from "../components/CmsPageRenderer.astro";
import { getPage } from "@/lib/posts";

const page = await getPage("/about");

const pageTitle = page?.seo?.title || page?.title || "About | ShaunEvans.com";
const description =
  page?.seo?.meta_description ||
  "About Shaun Evans - Canadian-Australian Saxophonist, Arranger & Musical Director";
const site_name = "ShaunEvans.com";
---

<BaseLayout
  title={pageTitle}
  description={description}
  site_name={site_name}
  is404Page={false}
  hideHeaderFooter={false}
>
  {
    page ? (
      <CmsPageRenderer blocks={page.blocks} />
    ) : (
      <div class="mx-auto max-w-3xl px-4 py-8">
        <p>About page is not available right now. Please check back soon.</p>
      </div>
    )
  }
</BaseLayout>
