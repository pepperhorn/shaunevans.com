---
import AudioPlayer from "@/components/cms/AudioPlayer";
import { assetUrl, type CmsBlock } from "@/lib/directus";

interface Props {
  blocks: CmsBlock[];
}

const { blocks } = Astro.props;

// Helpers to safely read fields off the generic `item` payload.
const str = (v: unknown): string => (typeof v === "string" ? v : "");
const bool = (v: unknown): boolean => Boolean(v);
---

<div class="cms-page">
  {
    blocks.map((b) => {
      const bg = b.background ?? null;
      const wrapperClasses = [
        "cms-block",
        `cms-block-${b.collection}`,
        bg === "dark" ? "cms-bg-dark" : bg === "light" ? "cms-bg-light" : "",
      ].filter(Boolean).join(" ");

      if (b.collection === "block_richtext") {
        const headline = str(b.item.headline);
        const tagline = str(b.item.tagline);
        const content = str(b.item.content);
        const alignment = str(b.item.alignment) || "left";
        const width = str(b.item.width) || "tight";
        const hasBackground = bool(b.item.background);
        const containerClass = [
          "mx-auto px-4 py-8",
          width === "tight" ? "max-w-3xl" : "max-w-6xl",
          alignment === "center" ? "text-center" : "text-left",
          hasBackground ? "bg-slate-100 dark:bg-[rgb(40,39,43)] rounded-lg my-6" : "",
        ].filter(Boolean).join(" ");
        return (
          <section class={wrapperClasses}>
            <div class={containerClass}>
              {tagline && (
                <p class="cms-tagline font-overpass-mono uppercase text-sm text-gray-500 dark:text-gray-400 mb-2">
                  {tagline}
                </p>
              )}
              {headline && (
                <h2 class="cms-headline font-overpass-mono text-3xl sm:text-4xl mb-4">
                  {headline}
                </h2>
              )}
              {content && (
                <div
                  class="cms-richtext prose dark:prose-invert max-w-none"
                  set:html={content}
                />
              )}
            </div>
          </section>
        );
      }

      if (b.collection === "block_video") {
        const videoUrl = str(b.item.video_url);
        const headline = str(b.item.headline);
        const tagline = str(b.item.tagline);
        const posterUuid = str(b.item.poster_image);
        const poster = posterUuid ? assetUrl(posterUuid, "") : "";
        const autoplay = bool(b.item.autoplay);
        // Lowercase extension check — covers the common B2-hosted formats.
        const ext = videoUrl.split("?")[0]!.split(".").pop()?.toLowerCase() ?? "";
        const mime =
          ext === "webm" ? "video/webm" :
          ext === "mov" ? "video/quicktime" :
          ext === "ogv" || ext === "ogg" ? "video/ogg" :
          "video/mp4";
        return (
          <section class={wrapperClasses}>
            <div class="cms-video-container mx-auto max-w-4xl px-4 py-8">
              {tagline && (
                <p class="cms-tagline font-overpass-mono uppercase text-sm text-gray-500 dark:text-gray-400 mb-2 text-center">
                  {tagline}
                </p>
              )}
              {headline && (
                <h2 class="cms-headline font-overpass-mono text-3xl sm:text-4xl mb-4 text-center">
                  {headline}
                </h2>
              )}
              {videoUrl && (
                <video
                  class="cms-video w-full rounded-lg shadow"
                  controls
                  preload={autoplay ? "auto" : "metadata"}
                  poster={poster || undefined}
                  autoplay={autoplay || undefined}
                  muted={autoplay || undefined}
                  playsinline={autoplay || undefined}
                  loop={autoplay || undefined}
                >
                  <source src={videoUrl} type={mime} />
                  Your browser does not support the video tag.{" "}
                  <a href={videoUrl}>Download video</a>.
                </video>
              )}
            </div>
          </section>
        );
      }

      if (b.collection === "block_audio") {
        const audioUrl = str(b.item.audio_url);
        const headline = str(b.item.headline);
        const tagline = str(b.item.tagline);
        return (
          <section class={wrapperClasses}>
            {audioUrl && (
              <AudioPlayer
                client:only="react"
                audioUrl={audioUrl}
                headline={headline || undefined}
                tagline={tagline || undefined}
              />
            )}
          </section>
        );
      }

      // Unknown block type — render a debug placeholder so editors can spot it.
      return (
        <section class={wrapperClasses}>
          <div class="mx-auto max-w-3xl px-4 py-4 text-xs text-gray-500 italic">
            [Unsupported block: {b.collection}]
          </div>
        </section>
      );
    })
  }
</div>
