---
import Hamburger from "./Hamburger.astro";
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";
import CartIcon from "./shop/CartIcon.tsx";
import CartSheet from "./shop/CartSheet.tsx";
const { is404Page = false } = Astro.props;
---

<header class="sticky top-0 z-30 -mx-8 px-8 py-[10px] md:-mx-16 md:px-16 mb-[20px] -mt-8 md:-mt-8 pt-8 bg-[rgb(244,242,238)]/95 backdrop-blur supports-[backdrop-filter]:bg-[rgb(244,242,238)]/80 dark:bg-[rgb(34,33,37)]/95 dark:supports-[backdrop-filter]:bg-[rgb(34,33,37)]/80">
  <nav class="flex items-center justify-between w-full h-[30px]">
    {
      !is404Page && (
        <div class="flex items-center h-[30px]">
          <a href="/" class="header-logo block" aria-label="Home" transition:persist="header-logo">
            <se-logo-loop class="header-logo-mark block w-[30px]" label="Shaun Evans — home"></se-logo-loop>
          </a>
        </div>
      )
    }
    <div class="flex items-center h-[30px] gap-2">
      {
        !is404Page && (
          <>
            <div class="flex items-center justify-center h-[30px] w-[30px]">
              <ThemeToggle />
            </div>
            <div class="flex items-center justify-center h-[30px] w-[30px]">
              <CartIcon client:only="react" />
            </div>
            <div class="flex items-center justify-center h-[30px] w-[30px]">
              <Hamburger />
            </div>
          </>
        )
      }
    </div>
  </nav>
  {
    !is404Page && (
      <div class="absolute right-0 mt-2">
        <Navigation />
      </div>
    )
  }
  <slot />
  {!is404Page && <CartSheet client:only="react" />}
</header>

<script>
  import "@/scripts/se-logo-loop.js";
</script>
